{
  "name": "tinynotes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun ./node_modules/next/dist/bin/next dev",
    "build": "bun ./node_modules/next/dist/bin/next build",
    "start": "bun ./node_modules/next/dist/bin/next start",
    "lint": "oxlint && eslint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "db:migrate": "bun scripts/migrate.ts",
    "migrate:up": "bun scripts/migrate.ts up",
    "migrate:down": "bun scripts/migrate.ts down",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tiptap/core": "3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@tiptap/static-renderer": "3.32.2",
    "better-auth": "1.7.17",
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bun": "1.4.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "auth": "1.7.17",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.4",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
