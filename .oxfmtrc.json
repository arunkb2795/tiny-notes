{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": false,
  "semi": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    "sites/**",
    ".bun-cache/**",
    ".codex/**",
    ".agents/**",
    ".aws/**",
    ".next/**",
    "out/**",
    "build/**",
    "coverage/**",
    "next-env.d.ts",
    "bun.lock",
    "migrations/**"
  ]
}
